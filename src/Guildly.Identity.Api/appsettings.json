    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Server": "<should-be-overriden>",
    "Name": "<should-be-overriden>",
    "Username": "<should-be-overriden>",
    "Password": "<should-be-overriden>",
    "Port": "<should-be-overriden>"
  },

